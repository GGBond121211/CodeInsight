# Step 9 local Compose defaults. Replace model credentials only for a real model smoke.
CODEINSIGHT_GATEWAY_FAKE_MODE=1
CODEINSIGHT_API_KEY=replace-with-your-chat-key
CODEINSIGHT_MODEL=deepseek-v4-flash
CODEINSIGHT_BASE_URL=https://example.com/v1
CODEINSIGHT_EMBEDDING_API_KEY=replace-with-your-embedding-key
CODEINSIGHT_EMBEDDING_MODEL=replace-with-your-embedding-model
CODEINSIGHT_EMBEDDING_BASE_URL=https://example.com/v1
CODEINSIGHT_RERANK_API_KEY=replace-with-your-rerank-key
CODEINSIGHT_RERANK_MODEL=qwen3.7-text-rerank
CODEINSIGHT_RERANK_BASE_URL=https://example.com/compatible-mode/v1
CODEINSIGHT_MYSQL_HOST=mysql
CODEINSIGHT_MYSQL_PORT=3306
CODEINSIGHT_MYSQL_USER=codeinsight
CODEINSIGHT_MYSQL_PASSWORD=codeinsight-dev
CODEINSIGHT_MYSQL_DATABASE=codeinsight_v2
CODEINSIGHT_REDIS_URL=redis://redis:6379/0
CODEINSIGHT_CELERY_BROKER_URL=redis://redis:6379/1
CODEINSIGHT_CELERY_RESULT_BACKEND=redis://redis:6379/2

# 兼容 OpenAI 接口的聊天模型
CODEINSIGHT_API_KEY=replace-with-your-chat-key
# 运行环境。生产部署必须显式设置为 production。
CODEINSIGHT_ENV=development
# 本地调试便利开关默认关闭；ops/docker-compose.yml 的开发栈会显式打开它们。
CODEINSIGHT_DEV_MODE=0
CODEINSIGHT_DEV_AUTO_APPROVE=0
CODEINSIGHT_DEV_SKIP_SANDBOX_VALIDATION=0
# Q-008 代码理解迁移开关：只影响 explain 路线，不影响 change / 普通聊天 / 范围引导。
# 默认 0（走原有 LangGraph/linear 路径）。新旧路线尚未做同数据对照，不要在生产打开。
# CODEINSIGHT_CODE_UNDERSTANDING_TOOL_LOOP=1
# Step 7 Gateway 默认最佳模型。模型路由与降级价格见 candidate_models.yaml。
CODEINSIGHT_MODEL=deepseek-v4-flash
CODEINSIGHT_BASE_URL=https://api.frontier-intelligence.tech/v1
# reasoning 模型的 reasoning 与最终 JSON 共用输出额度；默认 40960，可按 Provider 调整。
# CODEINSIGHT_MAX_OUTPUT_TOKENS=40960
# 可选：仅填写同一个 CODEINSIGHT_BASE_URL 确实支持的备用模型，逗号分隔。
# 留空时不启用自动降级，避免把其他供应商的模型误发到当前端点。
# CODEINSIGHT_FALLBACK_MODELS=deepseek-v4-flash-vision-exp

# 兼容 OpenAI 接口的 Embedding 模型
CODEINSIGHT_EMBEDDING_API_KEY=replace-with-your-embedding-key
CODEINSIGHT_EMBEDDING_MODEL=replace-with-your-embedding-model
CODEINSIGHT_EMBEDDING_BASE_URL=https://example.com/v1
# 只对默认只返回 Dense、需要显式请求才会带 Sparse 的 Provider 设置。
# 阿里云 MaaS 的 qwen3.7-text-embedding 用 dense&sparse；留空时不发送该参数。
# CODEINSIGHT_EMBEDDING_OUTPUT_TYPE=dense&sparse

# 阿里云百炼文本重排序（默认与 Embedding 共用 API Key）
# 兼容模式 base URL 会自动转换为 /compatible-api/v1/reranks。
# CODEINSIGHT_RERANK_API_KEY=replace-with-your-rerank-key
# CODEINSIGHT_RERANK_BASE_URL=https://example.com/compatible-mode/v1
# CODEINSIGHT_RERANK_MODEL=qwen3.7-text-rerank

# 2.1 运行时向量后端（生产/持久化环境必须显式配置）
CODEINSIGHT_QDRANT_URL=http://127.0.0.1:6335
CODEINSIGHT_QDRANT_COLLECTION=codeinsight_2_1_dense_sparse
CODEINSIGHT_QDRANT_TIMEOUT=10

# ---------------------------------------------------------------------------
# MySQL —— Session / Goal / Run 三层状态的持久化（2.0 Step 2）
#
# 五项都不填时，应用回退到内存 Store（重启即丢失状态）。
# ---------------------------------------------------------------------------
CODEINSIGHT_MYSQL_HOST=127.0.0.1
CODEINSIGHT_MYSQL_PORT=3306
CODEINSIGHT_MYSQL_USER=replace-with-your-mysql-user
CODEINSIGHT_MYSQL_PASSWORD=replace-with-your-mysql-password
CODEINSIGHT_MYSQL_DATABASE=codeinsight_v2

# 集成测试专用的库，**必须与上面的应用库不同**。
# 集成测试会清空这个库的全部表；指向应用库会毁掉开发数据。
# 库名里必须含 "test"，否则 tests/integration/conftest.py 会直接判失败。
# 不设置时 MySQL 集成测试整体跳过。
CODEINSIGHT_MYSQL_TEST_DATABASE=codeinsight_v2_test

# 可选：Session / 检索热点缓存。未配置或不可用时回退事实 Store。
CODEINSIGHT_REDIS_URL=redis://127.0.0.1:6379/0

# Step 7 Celery Worker：只承载登记过的 Sandbox validation profile。
CODEINSIGHT_CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CODEINSIGHT_CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2
